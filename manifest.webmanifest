{
  "id": "./",
  "name": "엔터코딩 원별 납품 GPS 알리미",
  "short_name": "납품알리미",
  "description": "원별 납품 수량(1~4단계, 교사용, 기타 품목) 확인, 백그라운드 GPS 도착 알림, 내비 위 미니창(PiP), 네이버 내비 연동 웹앱",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "ko",
  "dir": "ltr",
  "categories": [
    "navigation",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
